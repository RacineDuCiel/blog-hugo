!.env.sample
!.env.template

# Réglages personnels des outils (launch.json reste partageable)
/.claude/settings.local.json
/.vscode/
/.idea/
*.swp
*.swo
*~

# Fichiers système
.DS_Store
._*
Thumbs.db
Desktop.ini

