{{- $index := slice -}}
{{- range where .Site.RegularPages "Section" "posts" -}}
  {{- if not .Params.unlisted -}}
    {{- $context := partial "article-context.html" . -}}
    {{- $index = $index | append (dict
      "title" .Title
      "url" .RelPermalink
      "description" (.Description | default (.Summary | plainify))
      "body" .Plain
      "tags" (.Params.tags | default slice)
      "category" $context.categorySlug
      "categoryLabel" $context.categoryLabel
      "format" $context.format
      "formatLabel" $context.formatLabel
      "date" (.Date.Format "2006-01-02")
      "readingTime" .ReadingTime
    ) -}}
  {{- end -}}
{{- end -}}
{{- $index | jsonify -}}
